{
  "expo": {
    "name": "ExpenseTracker",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F0FF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.garry183.expensetracker"
    },
    "android": {
      "package": "com.garry183.expensetracker"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ExpenseTracker to access your camera to scan receipts."
        }
      ]
    ],
    "scheme": "expensetracker",
    "experiments": {
      "typedRoutes": true
    }
  }
}
